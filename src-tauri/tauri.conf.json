{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "call-whisper",
  "version": "0.1.0",
  "identifier": "ai.callwhisper.windows",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "call-whisper",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 500
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "../vendor/": "vendor/" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["Polish", "English"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4NTk1OTQ1MTgwOENFQ0UKUldUT3pnZ1lSVmxaZUt4RThlZHZEL1hMVitReUVqcWNvMlNIZVArQ3hFUVUrdWtMNTRSRVp3UHkK",
      "endpoints": ["https://github.com/vibebrosi-main/call-whisper-windows-edition/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
